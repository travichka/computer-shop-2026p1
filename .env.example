# Copy to .env and replace the placeholders. Never commit .env.
# The same values are used by compose.yaml (container) and DATABASE_URL (app, Prisma CLI, scripts).

# PostgreSQL container (applied only when the volume is initialised for the first time;
# changing the password later does not change the existing user).
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me
# Host port published on 127.0.0.1; change it when 5432 is taken and update the URLs below.
POSTGRES_PORT=5432

# Connection from the host: localhost + published port. From another container in the same
# Compose network use the service name instead: postgresql://…@postgres:5432/…
# Special characters in the password must be percent-encoded (e.g. @ → %40, / → %2F).
# Server-only: never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://shop:change-me@localhost:5432/shop

# Separate database for integration tests (same server). The test setup refuses to run
# unless the database name ends with _test and differs from DATABASE_URL.
TEST_DATABASE_URL=postgresql://shop:change-me@localhost:5432/shop_test
