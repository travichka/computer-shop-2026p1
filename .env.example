# Copy to .env and replace the placeholders. Never commit .env.
# Local Development uses these values. Preview/Production values live ONLY in the secret store of
# that environment (Vercel → Settings → Environment Variables, GitHub → Settings → Secrets).
# None of the variables below has the NEXT_PUBLIC_ prefix: they must never reach the browser.

# ── Local PostgreSQL container (compose.yaml) ────────────────────────────────────────────────
# Applied only when the volume is initialised for the first time.
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me
# Host port published on 127.0.0.1; change it when 5432 is taken and update the URLs below.
POSTGRES_PORT=5432

# ── Database ─────────────────────────────────────────────────────────────────────────────────
# App connection (runtime, also read by prisma.config.ts for generate/migrate/seed).
# Local: the container. Production (Vercel): the POOLED endpoint of the remote database with the
# runtime role and verified TLS, e.g.
#   postgresql://shop_app:<password>@ep-xxx-pooler.eu-central-1.aws.neon.tech/shop?sslmode=verify-full
# localhost here would point at the Vercel function itself, not at your computer.
# Special characters in the password must be percent-encoded (e.g. @ → %40, / → %2F).
DATABASE_URL=postgresql://shop:change-me@localhost:5432/shop

# Max pg connections per server process (default 5). Every Vercel instance has its own pool,
# so keep instances × this value below the database/pooler limit.
DATABASE_POOL_MAX=5

# Migrations are NOT run with the app variable. The operator (or the GitHub "Migrate" workflow,
# secret MIGRATION_DATABASE_URL) passes the DIRECT endpoint of the owner role (DDL rights)
# as DATABASE_URL for that one command only:
#   postgresql://shop_owner:<password>@ep-xxx.eu-central-1.aws.neon.tech/shop?sslmode=verify-full

# Seed: demo accounts/orders are added only to a local database unless SEED_DEMO=true.
# The remote catalog seed is: SEED_DEMO=false npx --no-install prisma db seed
SEED_DEMO=

# Separate database for integration tests (same server). The test setup refuses to run
# unless the database name ends with _test and differs from DATABASE_URL.
TEST_DATABASE_URL=postgresql://shop:change-me@localhost:5432/shop_test

# ── Better Auth + GitHub OAuth App ───────────────────────────────────────────────────────────
# Separate values per environment: the local OAuth App and secret differ from Production.
# Secret: random, at least 32 characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
# Base URL (origin only). Local: http://localhost:3000. Production: the stable https domain,
# e.g. https://computer-shop-2026p1.vercel.app — on Vercel anything else is rejected at startup.
# The OAuth App callback must be <BETTER_AUTH_URL>/api/auth/callback/github.
BETTER_AUTH_URL=http://localhost:3000
# From GitHub → Settings → Developer settings → OAuth Apps (an OAuth App, not a GitHub App).
GITHUB_CLIENT_ID=replace-with-client-id
GITHUB_CLIENT_SECRET=replace-with-client-secret
