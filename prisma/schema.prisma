// Catalog of the computer shop. Constraints that Prisma cannot declare (CHECK, COLLATE "C")
// live in the SQL of the migrations in prisma/migrations.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Product category with a stable code used in URLs (?type=gpu) — cpu, gpu, ram, disk.
model Category {
  id       Int       @id @default(autoincrement())
  code     String    @unique
  name     String
  products Product[]
}

model Product {
  /// Explicit id kept from data/products.json (existing URLs /product-list/<id>); no autoincrement.
  id          Int      @id
  /// 10 uppercase ASCII letters or digits (CHECK in SQL).
  code        String   @unique @db.VarChar(10)
  /// Original name for display.
  name        String
  /// name.normalize("NFC").toLowerCase().normalize("NFC") — compared with COLLATE "C" (SQL).
  nameSortKey String   @db.Text
  description String
  /// Local URL of a file in public/, e.g. /images/products/cpu.webp.
  image       String
  /// Whole grosze, 0..2147483647 (int4 + CHECK >= 0).
  price       Int
  /// Units in stock, 0..2147483647 (int4 + CHECK >= 0).
  amount      Int
  /// Source UTC timestamp with milliseconds; sort key for "newest".
  date        DateTime @db.Timestamptz(3)
  categoryId  Int
  /// Restrict: a category with products cannot be deleted.
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cartItems   CartItem[]
  orderItems  OrderItem[]

  /// Catalog filter by category (?type=…) and the foreign-key check when a category is deleted.
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Better Auth (Lab 09) — models from `auth generate --adapter prisma` merged with the Lab 08 User.
// One user table: the adapter addresses models by name (prisma.user, prisma.session, …), so the
// tables keep the PascalCase names of this schema instead of the generated @@map("user") etc.
// ---------------------------------------------------------------------------

/// Auth user (string id generated by Better Auth — not the GitHub id and not the e-mail).
/// No password column: credentials and provider links live in Account.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  cart          Cart?
  orders        Order[]
}

/// Database session; the cookie carries the signed `token`. Deleting the row revokes the session.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Link of a provider account to a user: accountId is the GitHub account id, providerId "github".
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  /// One GitHub account belongs to exactly one shop user.
  @@unique([providerId, accountId])
  @@index([userId])
}

/// Short-lived verification values (e.g. OAuth state) managed by Better Auth.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Own cart (Lab 09) — models from the Lab 08 extension "Model koszyka".
// ---------------------------------------------------------------------------

/// At most one cart per user (unique userId = auth User.id). Created on the first write; no row
/// means an empty cart. Deleting the user deletes the cart.
model Cart {
  id        Int        @id @default(autoincrement())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  items     CartItem[]
}

/// One row per product in a cart; quantity 1..99 (CHECK in SQL).
model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  /// Cascade: deleting a cart deletes its items.
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  /// Restrict (Lab 09): a product that is in someone's cart cannot be deleted — archive it instead.
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int

  /// The same product cannot appear twice in one cart; also serves lookups by cartId.
  @@unique([cartId, productId])
  /// Foreign-key lookups when a product is deleted.
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Extension "Historia zamówień"
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id       Int         @id @default(autoincrement())
  /// Public order number, e.g. ZAM-2026-0001 (CHECK format in SQL).
  number   String      @unique
  status   OrderStatus @default(PENDING)
  userId   String
  /// Restrict: a user with order history cannot be deleted.
  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Sum of line totals in grosze; int8 covers many items at the maximum unit price.
  total    BigInt
  placedAt DateTime    @db.Timestamptz(3)
  items    OrderItem[]

  /// Order history of one user, newest first.
  @@index([userId, placedAt])
}

/// Line of an order with a snapshot of the product at purchase time. The optional relation uses
/// SetNull, so deleting a product keeps the line (code, name and prices stay in the snapshot).
model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productCode String   @db.VarChar(10)
  productName String
  /// Unit price in grosze at purchase time (int4 like Product.price).
  unitPrice   Int
  quantity    Int
  /// unitPrice × quantity in grosze (int8; CHECK in SQL keeps it consistent).
  lineTotal   BigInt

  @@index([orderId])
  @@index([productId])
}
